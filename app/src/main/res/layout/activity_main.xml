<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#222222"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/display_text_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#333333"
        android:padding="16dp"
        android:text="0"
        android:textColor="@android:color/white"
        android:textSize="60sp"
        android:gravity="end"
        android:maxLines="1"
        android:ellipsize="start"
        app:layout_constraintBottom_toTopOf="@+id/button_grid"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0"
        app:layout_constraintVertical_chainStyle="packed" />

    <GridLayout
        android:id="@+id/button_grid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:columnCount="4"
        android:rowCount="5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/display_text_view">

        <!-- Row 1 -->
        <Button
            android:id="@+id/button_clear"
            android:text="C"
            app:layout_columnWeight="1"
            app:layout_rowWeight="1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:textSize="30sp"
            android:textColor="@android:color/white"
            android:layout_margin="1dp"
            android:backgroundTint="#A0A0A0" />

        <Button
            android:text="+/-"
            android:visibility="invisible"
            app:layout_columnWeight="1"
            app:layout_rowWeight="1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:textSize="30sp"
            android:textColor="@android:color/white"
            android:layout_margin="1dp"
            android:backgroundTint="#A0A0A0" />

        <Button
            android:text="%"
            android:visibility="invisible"
            app:layout_columnWeight="1"
            app:layout_rowWeight="1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:textSize="30sp"
            android:textColor="@android:color/white"
            android:layout_margin="1dp"
            android:backgroundTint="#A0A0A0" />

        <Button
            android:id="@+id/button_divide"
            android:text="/"
            app:layout_columnWeight="1"
            app:layout_rowWeight="1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:textSize="30sp"
            android:textColor="@android:color/white"
            android:layout_margin="1dp"
            android:backgroundTint="#FF9800" />

        <!-- Row 2 -->
        <Button android:id="@+id/button_7" android:text="7" app:layout_columnWeight="1" app:layout_rowWeight="1" android:layout_width="0dp" android:layout_height="match_parent" android:textSize="30sp" android:textColor="@android:color/white" android:layout_margin="1dp" android:backgroundTint="#555555" />
        <Button android:id="@+id/button_8" android:text="8" app:layout_columnWeight="1" app:layout_rowWeight="1" android:layout_width="0dp" android:layout_height="match_parent" android:textSize="30sp" android:textColor="@android:color/white" android:layout_margin="1dp" android:backgroundTint="#555555" />
        <Button android:id="@+id/button_9" android:text="9" app:layout_columnWeight="1" app:layout_rowWeight="1" android:layout_width="0dp" android:layout_height="match_parent" android:textSize="30sp" android:textColor="@android:color/white" android:layout_margin="1dp" android:backgroundTint="#555555" />
        <Button android:id="@+id/button_multiply" android:text="*" app:layout_columnWeight="1" app:layout_rowWeight="1" android:layout_width="0dp" android:layout_height="match_parent" android:textSize="30sp" android:textColor="@android:color/white" android:layout_margin="1dp" android:backgroundTint="#FF9800" />

        <!-- Row 3 -->
        <Button android:id="@+id/button_4" android:text="4" app:layout_columnWeight="1" app:layout_rowWeight="1" android:layout_width="0dp" android:layout_height="match_parent" android:textSize="30sp" android:textColor="@android:color/white" android:layout_margin="1dp" android:backgroundTint="#555555" />
        <Button android:id="@+id/button_5" android:text="5" app:layout_columnWeight="1" app:layout_rowWeight="1" android:layout_width="0dp" android:layout_height="match_parent" android:textSize="30sp" android:textColor="@android:color/white" android:layout_margin="1dp" android:backgroundTint="#555555" />
        <Button android:id="@+id/button_6" android:text="6" app:layout_columnWeight="1" app:layout_rowWeight="1" android:layout_width="0dp" android:layout_height="match_parent" android:textSize="30sp" android:textColor="@android:color/white" android:layout_margin="1dp" android:backgroundTint="#555555" />
        <Button android:id="@+id/button_subtract" android:text="-" app:layout_columnWeight="1" app:layout_rowWeight="1" android:layout_width="0dp" android:layout_height="match_parent" android:textSize="30sp" android:textColor="@android:color/white" android:layout_margin="1dp" android:backgroundTint="#FF9800" />

        <!-- Row 4 -->
        <Button android:id="@+id/button_1" android:text="1" app:layout_columnWeight="1" app:layout_rowWeight="1" android:layout_width="0dp" android:layout_height="match_parent" android:textSize="30sp" android:textColor="@android:color/white" android:layout_margin="1dp" android:backgroundTint="#555555" />
        <Button android:id="@+id/button_2" android:text="2" app:layout_columnWeight="1" app:layout_rowWeight="1" android:layout_width="0dp" android:layout_height="match_parent" android:textSize="30sp" android:textColor="@android:color/white" android:layout_margin="1dp" android:backgroundTint="#555555" />
        <Button android:id="@+id/button_3" android:text="3" app:layout_columnWeight="1" app:layout_rowWeight="1" android:layout_width="0dp" android:layout_height="match_parent" android:textSize="30sp" android:textColor="@android:color/white" android:layout_margin="1dp" android:backgroundTint="#555555" />
        <Button android:id="@+id/button_add" android:text="+" app:layout_columnWeight="1" app:layout_rowWeight="1" android:layout_width="0dp" android:layout_height="match_parent" android:textSize="30sp" android:textColor="@android:color/white" android:layout_margin="1dp" android:backgroundTint="#FF9800" />

        <!-- Row 5 -->
        <Button
            android:id="@+id/button_0"
            android:text="0"
            android:layout_columnSpan="2"
            app:layout_columnWeight="2"
            app:layout_rowWeight="1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:textSize="30sp"
            android:textColor="@android:color/white"
            android:layout_margin="1dp"
            android:backgroundTint="#555555" />

        <Button
            android:id="@+id/button_decimal"
            android:text="."
            app:layout_columnWeight="1"
            app:layout_rowWeight="1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:textSize="30sp"
            android:textColor="@android:color/white"
            android:layout_margin="1dp"
            android:backgroundTint="#555555" />

        <Button
            android:id="@+id/button_equals"
            android:text="="
            app:layout_columnWeight="1"
            app:layout_rowWeight="1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:textSize="30sp"
            android:textColor="@android:color/white"
            android:layout_margin="1dp"
            android:backgroundTint="#007AFF" />

    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>